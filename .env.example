# Runtime
NODE_ENV=development
PORT=3000

# Authentication: dev for local JWTs, alb for AWS production.
AUTH_MODE=dev
DEV_JWT_SECRET=dev-secret-change-me

# Required for AUTH_MODE=alb.
AWS_REGION=ap-southeast-1
ALB_ARN=arn:aws:elasticloadbalancing:ap-southeast-1:123456789012:loadbalancer/app/example/1234567890abcdef
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override; otherwise derived from region and user pool ID.
# COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX
COGNITO_DOMAIN=example.auth.ap-southeast-1.amazoncognito.com
ALB_AUTH_COOKIE_NAME=AWSELBAuthSessionCookie
APP_LOGIN_REDIRECT=/access
APP_LOGOUT_URI=http://localhost:4200/login

# Production uses DATABASE_URL. Local development can use the DB_* fallback.
# DATABASE_URL=postgres://ddm_webapp:password@localhost:5432/ddm_webapp
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000

# Local Angular development only. Production is same-origin behind the ALB.
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:4200

# SSH gateway (required for session start outside local test stubs).
# SSH_GATEWAY_URL=https://gateway.example.com
# SSH_GATEWAY_EMAIL=service-account@example.com
# SSH_GATEWAY_PASSWORD=
# SSH_GATEWAY_COGNITO_REGION=ap-southeast-1
# SSH_GATEWAY_COGNITO_CLIENT_ID=
# SSH_GATEWAY_COGNITO_CLIENT_SECRET=
