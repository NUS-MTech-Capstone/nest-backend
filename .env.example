# Runtime
NODE_ENV=development
PORT=3000

# Authentication: dev for local JWTs, alb for AWS production.
AUTH_MODE=dev
DEV_JWT_SECRET=dev-secret-change-me

# Required for AUTH_MODE=alb.
AWS_REGION=ap-southeast-1
ALB_ARN=arn:aws:elasticloadbalancing:ap-southeast-1:123456789012:loadbalancer/app/example/1234567890abcdef
# Optional: if unset the pool ID is derived from the token's iss claim and a
# warning is logged with the derived value so you can pin it here.
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
# Must match the Cognito App Client the ALB listener uses (ALB console →
# Listeners → rule → Authenticate action). If omitted the client_id check
# is skipped — the ALB has already verified the user.
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override; otherwise derived from region and user pool ID.
# COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_XXXXXXXXX
COGNITO_DOMAIN=example.auth.ap-southeast-1.amazoncognito.com
ALB_AUTH_COOKIE_NAME=AWSELBAuthSessionCookie
APP_LOGIN_REDIRECT=/access
APP_LOGOUT_URI=http://localhost:4200/login 

# Production requires DATABASE_URL and DB_SSL=true. Local development can use
# the DB_* fallback with TLS disabled.
# DATABASE_URL=postgres://ddm_webapp:password@localhost:5432/ddm_webapp
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000

# Local Angular development only. Production is same-origin behind the ALB.
CORS_ENABLED=true
# Exact HTTP(S) origins only; wildcard origins are rejected.
CORS_ORIGINS=http://localhost:4200

# SSH gateway — required for terminal sessions.
# Production (AUTH_MODE=alb): set the in-cluster service URL. The backend
# forwards the logged-in user's Cognito access token (x-amzn-oidc-accesstoken)
# to the gateway, so no separate service-account credentials are needed.
#
# Same namespace (dendenmushi):
# SSH_GATEWAY_URL=http://proxy-controlplane:8080
#
# Cross-namespace:
# SSH_GATEWAY_URL=http://proxy-controlplane.dendenmushi.svc.cluster.local:8080
#
# Local development (AUTH_MODE=dev): configure a Cognito service account because
# dev login does not produce ALB access tokens.
# SSH_GATEWAY_EMAIL=service-account@example.com
# SSH_GATEWAY_PASSWORD=
# SSH_GATEWAY_COGNITO_REGION=ap-southeast-1
# SSH_GATEWAY_COGNITO_CLIENT_ID=   # falls back to COGNITO_CLIENT_ID when unset
# SSH_GATEWAY_COGNITO_CLIENT_SECRET=

# STS server inventory endpoint backing data. The endpoint reads VM rows from
# PostgreSQL and enriches SSH credential fields from this static JSON or the
# defaults below.
# Configure STS with SERVER_INVENTORY_URL=http://nest-backend:3000 in Kubernetes.
# Configure STS with CHANGE_REQUEST_URL=http://nest-backend:3000/sts in Kubernetes.
# SERVER_INVENTORY_STATIC_JSON={"host-dev-1":{"username":"ec2-user","credentialSecretId":"arn:aws:secretsmanager:...","hostPublicKey":"ssh-ed25519 AAAA..."}}
# SERVER_INVENTORY_DEFAULT_USERNAME=ec2-user
# SERVER_INVENTORY_DEFAULT_CREDENTIAL_SECRET_ID=
# SERVER_INVENTORY_DEFAULT_HOST_PUBLIC_KEY=

# CloudWatch monitoring (optional — requires IAM permissions on the pod role).
# CLOUDWATCH_REGION=ap-southeast-1
# CLOUDWATCH_LOG_GROUP=/aws/containerinsights/dendenmushi-cluster-dev/application
# CLOUDWATCH_SESSION_LOG_GROUP=/aws/containerinsights/dendenmushi-cluster-dev/application
# CLOUDWATCH_NAMESPACE=DenDenMushi

# Optional Redis cache for successful CloudWatch alarm and metric reads only.
# Authentication, authorization, logs, alerts, and terminal data are not cached.
REDIS_CACHE_ENABLED=false
# REDIS_URL=redis://localhost:6379
MONITORING_CACHE_TTL_SECONDS=60
